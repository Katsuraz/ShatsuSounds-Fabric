{
  "schemaVersion": 1,
  "id": "shatsusounds",
  "version": "${version}",
  "name": "Pixel Eco — Shatsu Retro Edition",
  "description": "Shatsu's original Fabric sound mod and integrations, transformed into warm arcade-fantasy retro audio.",
  "authors": [
    "Katsuraz",
    "Pixel Eco Retro Edition"
  ],
  "license": "LicenseRef-Shatsu-Audio-See-Docs",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.shatsu.sounds.client.ShatsuClient"
    ],
    "modmenu": [
      "dev.shatsu.sounds.client.ShatsuModMenu"
    ]
  },
  "mixins": [
    "shatsu-sounds.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "sound_physics_remastered": "*",
    "clangor": "*",
    "sound": "*",
    "customblocksounds": "*"
  }
}
